# Copy to .env.local for local dev.

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Canonical site URL - used for sitemap.xml, robots.txt, and SEO metadata
# (Open Graph URLs, hreflang alternates). In production, set this to the
# real deployed domain (e.g. https://alnaafi.netlify.app or a custom domain).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
