# Copy to .env for local dev. In production, these must come from a secrets
# manager (e.g. AWS Secrets Manager, GCP Secret Manager, Doppler) — never
# committed, never baked into images.

# --- App ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Database (Postgres via Prisma) ---
DATABASE_URL="postgresql://malik:malik_dev_password@localhost:5432/malik_travel?schema=public"

# --- Redis (cache / session state) ---
REDIS_URL="redis://localhost:6379"

# --- Amadeus ---
# Self-Service sandbox credentials: register at https://developers.amadeus.com
# AMADEUS_MODE selects the GDS implementation behind AmadeusModule's interface.
# "self-service" = REST sandbox (now). "enterprise" = SOAP Web Services (later,
# once we have a PCC/Office ID) — see CLAUDE.md "Amadeus swap plan".
AMADEUS_MODE=self-service
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_API_BASE_URL=https://test.api.amadeus.com
AMADEUS_OFFER_CACHE_TTL_SECONDS=900

# --- Search ---
SEARCH_RESULTS_CACHE_TTL_SECONDS=300

# --- Booking session ---
# Signs the booking-session cookie — generate a real random value per
# environment (e.g. `openssl rand -base64 32`). Never share this value
# across environments and never commit a real one.
SESSION_SECRET=
BOOKING_SESSION_TTL_SECONDS=1800

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
