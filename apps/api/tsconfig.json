{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    // Without this, tsc infers the output root from every .ts file it sees -
    // including apps/api/scripts/hash-admin-password.ts and
    // apps/api/prisma/seed.ts, both outside src/ - which pushes everything
    // down a level (dist/src/main.js instead of dist/main.js). Render's
    // start command runs `node dist/main`, so that mismatch is a real
    // deploy-breaking bug, not just a style nit.
    "rootDir": "./src",
    "baseUrl": "./",
    "incremental": true,
    // Without an explicit path, tsc's incremental cache file defaults to
    // living next to tsconfig.json (project root), *outside* outDir. That
    // defeats nest-cli.json's deleteOutDir:true safety net: deleting dist/
    // doesn't touch the cache, so a later build can see "0 source changes
    // since last run" and skip emitting entirely - even though dist/ is
    // gone - leaving `node dist/main` (or nest start's own watch process)
    // unable to find anything to run. Bit both a local `nest build` and a
    // `nest start --watch` restart this same session. Putting the cache
    // inside dist/ means deleteOutDir actually wipes it too.
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  },
  // rootDir above requires every compiled file to live under src/ - scripts/
  // and prisma/seed.ts are one-off ts-node entry points (see package.json's
  // admin:hash-password and prisma.seed scripts), never part of the built
  // app, so they're excluded here rather than compiled alongside it.
  "include": ["src/**/*.ts"]
}
